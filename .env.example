# -----------------------------------------------------------------------
# Valora — local environment configuration
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# .env is gitignored; this template is committed so every variable the
# project needs is documented in one place. Keep it up to date as new
# variables are introduced in later milestones.
# -----------------------------------------------------------------------

# --- Postgres container bootstrap -----------------------------------------
# Read by docker-compose.yml to initialise the postgres:17 container on
# first run. Must stay in sync with the credentials embedded in
# DATABASE_URL below — the container itself never parses DATABASE_URL.
POSTGRES_DB=valora
POSTGRES_USER=valora
POSTGRES_PASSWORD=valora

# --- Application database connection ---------------------------------------
# Read by the Python and TypeScript config loaders. Host/port point at the
# postgres container's host-mapped port for local, non-containerised dev.
DATABASE_URL=postgres://valora:valora@localhost:5432/valora

# --- AWS / LocalStack --------------------------------------------------
# Leave AWS_ENDPOINT_URL set to the LocalStack edge port for local dev.
# Unset it (or set it to an empty string) to talk to real AWS instead —
# this is a data difference the config loaders resolve for you; no code
# should ever branch on "am I local or real AWS" itself.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=af-south-1

# Dummy values are accepted by LocalStack. Real AWS requires real
# credentials (e.g. via `aws configure` or an assumed role) — never commit
# real credentials here or anywhere else in the repo.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=valora-documents-dev
